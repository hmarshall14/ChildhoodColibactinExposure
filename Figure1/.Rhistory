compare_cohort_df <- crypt_attributions %>%
filter(biopsy_SBS89_ID25_pos == FALSE, patient_colibactin_pos == FALSE)%>%
mutate(cohort=factor(cohort,levels=c("Normal" ,"IBD")))
compare_cohort_df <- crypt_attributions %>%
filter(biopsy_SBS89_ID83C_pos == FALSE, patient_colibactin_pos == FALSE)%>%
mutate(cohort=factor(cohort,levels=c("Normal" ,"IBD")))
age_location_ibd_included_lmer <- lmer(
SBSBackground ~ age:site + (1 | patient),
data = compare_cohort_df
)
age_location_cohort_lmer <- lmer(
SBSBackground ~ age:site + cohort + (1 | patient),
data = compare_cohort_df
)
anova(age_location_cohort_lmer, age_location_ibd_included_lmer)
cohort_comparison_conf_int <- as.data.frame(confint(age_location_cohort_lmer)) %>%
rownames_to_column("variable") %>%
dplyr::rename(lower_ci = `2.5 %`, upper_ci = `97.5 %`)
cohort_comparison_summary <- coef_table(age_location_cohort_lmer) %>%
left_join(cohort_comparison_conf_int, by = "variable") %>%
mutate(
across(c(Estimate, lower_ci, upper_ci), ~ round(.x, digits = 0)),
pvalue = round(pvalue, digits = 3),
text   = paste0(Estimate, " mutations 95% CI [", lower_ci, ", ", upper_ci, "]")
) %>%
dplyr::select(variable, Estimate, pvalue, text)
cohort_comparison_summary
signature_models <- c("SBS1", "SBS5", "SBS18") %>%
set_names() %>%
map(~ lmer(
as.formula(paste0(.x, " ~ age:site + cohort + (1 | patient)")),
data = compare_cohort_df
))
# Signs are flipped to absolute values because the Normal cohort has the lower rate
signature_effects <- signature_models %>%
map_dfr(
~ coef_table(.x) %>%
filter(variable == "cohortIBD") %>%
transmute(
estimate = round(abs(Estimate), 0),
lower_ci = abs(round(Estimate + 1.96 * std_error, 0)),
upper_ci = abs(round(Estimate - 1.96 * std_error, 0)),
pvalue   = round(pvalue, 3)
),
.id = "signature"
) %>%
mutate(text = paste0(estimate, " mutations 95% CI [", lower_ci, ", ", upper_ci, "], p = ", pvalue))
signature_effects
indel_age_location_cohort_lmer <- lmer(
indel_muts ~ age:site + cohort + (1 | patient),
data = compare_cohort_df
)
id_ibd_conf <- as.data.frame(confint(indel_age_location_cohort_lmer)) %>%
rownames_to_column("variable") %>%
dplyr::rename(lower_ci = `2.5 %`, upper_ci = `97.5 %`)
id_ibd_summary <- coef_table(indel_age_location_cohort_lmer) %>%
left_join(id_ibd_conf, by = "variable") %>%
mutate(
across(c(Estimate, lower_ci, upper_ci), ~ (round(.x, digits = 1))),
pvalue=round(pvalue,4),
text = paste0(Estimate, " mutations/year 95% CI [", lower_ci, ", ", upper_ci, "]")
) %>%
dplyr::select(variable, Estimate, pvalue, text)
id_ibd_summary
sbs_pvalue=paste0('P = ',cohort_comparison_summary[cohort_comparison_summary$variable=='cohortIBD',]$pvalue)
sbs_ibd_compare<-ggplot(data=compare_cohort_df,aes(x=cohort,y=snv_total_burden))+
geom_boxplot(fill='grey40')+
labs(x='',y='SBS Background mutation burden')+
scale_x_discrete(labels=c('Histologically Normal','Inflammatory Bowel\nDisease'))+
theme_classic()+
geom_text(aes(label = sbs_pvalue, y = 0.98*2100, x = 1.5),size=6)+
geom_segment(aes(x = 1, xend = 2, y = 0.96*2100, yend = 0.96*2100),color='grey20', inherit.aes = FALSE, size = 0.6) +
geom_segment(aes(x = 1, xend = 1, y = 0.96*2100,yend = 0.94*2100),  color='grey20',inherit.aes = FALSE, size = 0.6) +
geom_segment(aes(x = 2, xend = 2, y = 0.96*2100, yend = 0.94*2100),  color='grey20',inherit.aes = FALSE, size = 0.6) +
theme(axis.title=element_text(face='bold',size=20),
axis.text.x=element_text(face='bold',size=20),
axis.text.y=element_text(size=16))
id_pvalue=paste0('P = ',round(id_ibd_summary[id_ibd_summary$variable=='cohortIBD',]$pvalue,3))
id_ibd_compare<-ggplot(data=compare_cohort_df,aes(x=cohort,y=indel_total_burden))+
geom_boxplot(fill='grey40')+
labs(x='',y='ID Background mutation burden')+
scale_x_discrete(labels=c('Histologically Normal','Inflammatory Bowel\nDisease'))+
theme_classic()+
geom_text(aes(label = id_pvalue, y = 0.98*130, x = 1.5),size=6)+
geom_segment(aes(x = 1, xend = 2, y = 0.96*130, yend = 0.96*130),color='grey20', inherit.aes = FALSE, size = 0.6) +
geom_segment(aes(x = 1, xend = 1, y = 0.96*130,yend = 0.94*130),  color='grey20',inherit.aes = FALSE, size = 0.6) +
geom_segment(aes(x = 2, xend = 2, y = 0.96*130, yend = 0.94*130),  color='grey20',inherit.aes = FALSE, size = 0.6) +
theme(axis.title=element_text(face='bold',size=20),
axis.text.x=element_text(face='bold',size=20),
axis.text.y=element_text(size=16))
svglite::svglite('../Supplementary_Figures/compare_background_muts_ibd_normal.svg',width=16,height=10)
sbs_ibd_compare+id_ibd_compare
dev.off()
