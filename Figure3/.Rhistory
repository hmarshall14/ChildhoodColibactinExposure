exposures <- exposures %>%  dplyr::select(-SBSAssigned)
exposures <- exposures %>%
mutate(across(contains('SBS'),~(.x / rowSums(exposures[, grepl("SBS", colnames(exposures)), drop = FALSE]))*branch.length))%>%
dplyr::select(-node, -branch.length)
row.names(exposures) = exposures$branch_id
trunk_branches=paste0(patient,'_',tree_df[tree_df$x<50 & tree_df$branch.length<50,]$node)
insufficient_length_branches=paste0(patient,'_',tree_df[tree_df$x>50&tree_df$branch.length<44,]$node)
## trunk adjustments
exposures$SBSTrunk = ifelse(
exposures$branch_id %in% trunk_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
exposures$SBSInsufficient= ifelse(
exposures$branch_id %in% insufficient_length_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned","SBSInsufficient")){
exposures[[s]] <- ifelse(exposures$SBSTrunk > 0, 0, exposures[[s]])
}
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned")){
exposures[[s]] <- ifelse(exposures$SBSInsufficient > 0, 0, exposures[[s]])
}
exposures<-exposures%>%
mutate(SBSBackground=SBS1+SBS5+SBS18+SBSUnassigned)%>%
dplyr::select(branch_id,SBSBackground,SBSTrunk,SBSInsufficient,SBS89,SBS88)
row.names(exposures)<-exposures$branch_id
sigs = colnames(exposures)[2:length(colnames(exposures))]
