svglite(paste0('../Figure3/all_trees_plotted/',patient,'.svg'),width=10,height=10)
br_lengths = NULL
plot(tree, show.tip.label = T, cex.main = 1.2)
axisPhylo(side = 1,las = 1, backward = FALSE,cex.axis = 1.2)
mtext("Total SBS Burden", side = 1, line = 3, font = 2,cex=1.2)
## create an annotation dataframe for sigmoid / ascending colon
pp <- get("last_plot.phylo", envir = .PlotPhyloEnv)
offset_in <- 0.5    # ~3–4 mm on most plots
# convert plotting offset -> tree coordinate units
usr <- par("usr")              # x/y limits in user coords
pin <- par("pin")              # plot width/height in inches
unit_per_in <- diff(usr[1:2]) / pin[1]
const_offset <- offset_in * unit_per_in
## create a dataframe for the branch annotation
patient_branch_annotation=distinct(branch_annotation[str_detect(branch_annotation$branch_id,patient),])
tree_df$branch_id=paste0(patient,'_',tree_df$node)
branch_annots<-left_join(tree_df,patient_branch_annotation,by='branch_id')
branch_annots$y_pos <- pp$yy[branch_annots$node]
branch_annots=branch_annots[branch_annots$branch_status%in%c('First positive branch','Post cessation branch','Post cessation branch - Indeterminant','Second positive branch'),]
branch_annots$colour=case_when(branch_annots$branch_status=='First positive branch'~'skyblue2',
branch_annots$branch_status=='Post cessation branch'~'orange1',
branch_annots$branch_status=='Post cessation branch - Indeterminant'~'grey40',#scales::alpha("orange1", 0.5),
branch_annots$branch_status=='Second positive branch'~'green4',
TRUE~NA
)
branch_annots$x_pos=branch_annots$x - branch_annots$branch.length
title(main = paste0(patient, " [", age, " years ", gender, "]"),cex=2)
for (k in seq_along(samples)) {
n = as.numeric(branches[k])
x_end = tree_df$x[n]
x_start = tree_df$x[tree_df$parent[n]]
y = node.height(tree)[n]
tipnum = sum(tree_df$isTip)
for (s in sigs){
x_end = x_start + exposures[samples[k], s]
rect(
ybottom = y - min(0.02*tipnum, 0.4),
ytop    = y + min(0.02*tipnum, 0.4),
xleft   = x_start,
xright  = x_end,
col     = cols[s],
border  = "black",
lwd     = 2
)
x_start = x_end
}
}
points(
x = branch_annots$x_pos,
y = branch_annots$y_pos,
pch = 23,
bg = branch_annots$colour,
col = "black",
cex = 3,
lwd = 2)
cat(paste0('completed ',patient))
## close the single combined PDF
dev.off()
}
svglite::svglite(file = paste0("../Figure3/tree_legend_only.svg"), width = 10, height = 4)
sigs_legend_df<-data.frame(cols=c('skyblue2','green4','orange1','grey40','bisque3','maroon3','grey20','grey40'),
shape=c(23,23,23,23,22,22,22,22),
labs=c('Earliest possible commencement of exposure','Ongoing exposure',
'Latest possible cessation of exposure','Indeterminant branch point',
'SBSBackground [proportion of branch]',
'SBS88 [proportion of branch]',
'Truncal branch',
'Insufficient branch length / SBS88 present in unpruned attribution'
))
par(mar = c(0, 0, 0, 0))
plot.new()
plot.window(xlim = c(0, 1), ylim = c(0, 1))
legend(
"center",
legend = sigs_legend_df$labs,
pt.bg = sigs_legend_df$cols,
pch= sigs_legend_df$shape,
ncol = 2,
bty = "n",
pt.cex = 1.2,
cex    = 0.9,
xjust = 0.5
)
dev.off()
