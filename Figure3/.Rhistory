age = biopsy_metadata[biopsy_metadata$patient == patient, ]$age[1]
gender = biopsy_metadata[biopsy_metadata$patient == patient, ]$sex[1]
## load tree file for the patient
tree_file = paste0(dir, patient, "/",patient,".tree_with_branch_length.tree")
if (!file.exists(tree_file)) next
tree = read.tree(tree_file)
tip_labels=data.frame(tips=tree$tip.label,
biopsy=str_extract(tree$tip.label,'PD\\d{5}\\w'))
tip_labels=left_join(tip_labels,biopsy_metadata,by='biopsy')
tip_labels$label=paste0(tip_labels$location," colon")
tree$tip.label =tip_labels[tip_labels$tips==tree$tip.label,]$label
tree_df = ggtree::fortify(tree)
## calculate mutations not assigned to signatures
node_muts <- tree_df %>% dplyr::select(node, branch.length)
exposures$node = as.numeric(str_extract(exposures$branch_id, '(?<=\\_)\\d+'))
exposures$SBSAssigned=exposures$SBS1+exposures$SBS5+exposures$SBS18+exposures$SBS88+exposures$SBS89
exposures = left_join(exposures, node_muts, by='node')
