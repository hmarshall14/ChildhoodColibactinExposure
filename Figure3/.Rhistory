head*exposures
head(exposures)
exposures <- exposures %>%
dplyr::select(-SBSAssigned)%>%
mutate(across(contains('SBS'),~.x / rowSums(exposures[, grepl("SBS", colnames(exposures)), drop = FALSE])))%>%
dplyr::select(-node, -branch.length)
row.names(exposures) = exposures$branch_id
trunk_branches=paste0(patient,'_',tree_df[tree_df$x<50 & tree_df$branch.length<50,]$node)
insufficient_length_branches=paste0(patient,'_',tree_df[tree_df$x>50&tree_df$branch.length<44,]$node)
## trunk adjustments
exposures$SBSTrunk = ifelse(
exposures$branch_id %in% trunk_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
for (patient in patients){
## filter the exposures dataframe for the patient of interest
exposures = msa_branches[str_detect(msa_branches$branch_id, patient), ]
row.names(exposures) = exposures$branch_id
age = biopsy_metadata[biopsy_metadata$patient == patient, ]$age[1]
gender = biopsy_metadata[biopsy_metadata$patient == patient, ]$sex[1]
## load tree file for the patient
tree_file = paste0(dir, patient, "/",patient,".tree_with_branch_length.tree")
if (!file.exists(tree_file)) next
tree = read.tree(tree_file)
tip_labels=data.frame(tips=tree$tip.label,
biopsy=str_extract(tree$tip.label,'PD\\d{5}\\w'))
tip_labels=left_join(tip_labels,biopsy_metadata,by='biopsy')
tip_labels$label=paste0(tip_labels$location," colon")
tree$tip.label =tip_labels[tip_labels$tips==tree$tip.label,]$label
tree_df = ggtree::fortify(tree)
## calculate mutations not assigned to signatures
node_muts <- tree_df %>% dplyr::select(node, branch.length)
exposures$node = as.numeric(str_extract(exposures$branch_id, '(?<=\\_)\\d+'))
exposures$SBSAssigned=exposures$SBS1+exposures$SBS5+exposures$SBS18+exposures$SBS88+exposures$SBS89
exposures = left_join(exposures, node_muts, by='node')
exposures$SBSUnassigned=ifelse(exposures$branch.length - exposures$SBSAssigned>0, exposures$branch.length - exposures$SBSAssigned, 0)
exposures <- exposures %>%
dplyr::select(-SBSAssigned)%>%
mutate(across(contains('SBS'),~.x / rowSums(exposures[, grepl("SBS", colnames(exposures)), drop = FALSE])))%>%
dplyr::select(-node, -branch.length)
row.names(exposures) = exposures$branch_id
trunk_branches=paste0(patient,'_',tree_df[tree_df$x<50 & tree_df$branch.length<50,]$node)
insufficient_length_branches=paste0(patient,'_',tree_df[tree_df$x>50&tree_df$branch.length<44,]$node)
## trunk adjustments
exposures$SBSTrunk = ifelse(
exposures$branch_id %in% trunk_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
exposures$SBSInsufficient= ifelse(
exposures$branch_id %in% insufficient_length_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned","SBSInsufficient")){
exposures[[s]] <- ifelse(exposures$SBSTrunk > 0, 0, exposures[[s]])
}
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned")){
exposures[[s]] <- ifelse(exposures$SBSInsufficient > 0, 0, exposures[[s]])
}
exposures<-exposures%>%
mutate(SBSBackground=SBS1+SBS5+SBS18+SBSUnassigned)%>%
dplyr::select(branch_id,SBSBackground,SBSTrunk,SBSInsufficient,SBS89,SBS88)
row.names(exposures)<-exposures$branch_id
sigs = colnames(exposures)[2:length(colnames(exposures))]
cols = c("bisque2",'grey20','grey40','palegreen4',"maroon3")
names(cols) = sigs
samples = exposures$branch_id[grepl(patient, exposures$branch_id)]
branches = sub(".*_", "", samples)
## --- PLOT BEGINS (no pdf() call here!) ---
svglite(paste0('../Figure3/all_trees_plotted/',patient,'.svg'),width=10,height=10)
br_lengths = NULL
plot(tree, show.tip.label = T, cex.main = 1.2)
axisPhylo(side = 1,las = 1, backward = FALSE,cex.axis = 1.2)
mtext("Total SBS Burden", side = 1, line = 3, font = 2,cex=1.2)
## create an annotation dataframe for sigmoid / ascending colon
pp <- get("last_plot.phylo", envir = .PlotPhyloEnv)
offset_in <- 0.5    # ~3–4 mm on most plots
# convert plotting offset -> tree coordinate units
usr <- par("usr")              # x/y limits in user coords
pin <- par("pin")              # plot width/height in inches
unit_per_in <- diff(usr[1:2]) / pin[1]
const_offset <- offset_in * unit_per_in
## create a dataframe for the branch annotation
patient_branch_annotation=distinct(branch_annotation[str_detect(branch_annotation$branch_id,patient),])
tree_df$branch_id=paste0(patient,'_',tree_df$node)
branch_annots<-left_join(tree_df,patient_branch_annotation,by='branch_id')
branch_annots$y_pos <- pp$yy[branch_annots$node]
branch_annots=branch_annots[branch_annots$branch_status%in%c('First positive branch','Post cessation branch','Post cessation branch - Indeterminant','Second positive branch'),]
branch_annots$colour=case_when(branch_annots$branch_status=='First positive branch'~'skyblue2',
branch_annots$branch_status=='Post cessation branch'~'orange1',
branch_annots$branch_status=='Post cessation branch - Indeterminant'~'grey40',#scales::alpha("orange1", 0.5),
branch_annots$branch_status=='Second positive branch'~'green4',
TRUE~NA
)
branch_annots$x_pos=branch_annots$x - branch_annots$branch.length
title(main = paste0(patient, " [", age, " years ", gender, "]"),cex=2)
for (k in seq_along(samples)) {
n = as.numeric(branches[k])
x_end = tree_df$x[n]
x_start = tree_df$x[tree_df$parent[n]]
y = node.height(tree)[n]
tipnum = sum(tree_df$isTip)
for (s in sigs){
x_end = x_start + exposures[samples[k], s]
rect(
ybottom = y - min(0.02*tipnum, 0.4),
ytop    = y + min(0.02*tipnum, 0.4),
xleft   = x_start,
xright  = x_end,
col     = cols[s],
border  = "black",
lwd     = 2
)
x_start = x_end
}
}
points(
x = branch_annots$x_pos,
y = branch_annots$y_pos,
pch = 23,
bg = branch_annots$colour,
col = "black",
cex = 3,
lwd = 2)
cat(paste0('completed ',patient))
## close the single combined PDF
dev.off()
}
for (patient in patients){
## filter the exposures dataframe for the patient of interest
exposures = msa_branches[str_detect(msa_branches$branch_id, patient), ]
row.names(exposures) = exposures$branch_id
age = biopsy_metadata[biopsy_metadata$patient == patient, ]$age[1]
gender = biopsy_metadata[biopsy_metadata$patient == patient, ]$sex[1]
## load tree file for the patient
tree_file = paste0(dir, patient, "/",patient,".tree_with_branch_length.tree")
if (!file.exists(tree_file)) next
tree = read.tree(tree_file)
tip_labels=data.frame(tips=tree$tip.label,
biopsy=str_extract(tree$tip.label,'PD\\d{5}\\w'))
tip_labels=left_join(tip_labels,biopsy_metadata,by='biopsy')
tip_labels$label=paste0(tip_labels$location," colon")
tree$tip.label =tip_labels[tip_labels$tips==tree$tip.label,]$label
tree_df = ggtree::fortify(tree)
## calculate mutations not assigned to signatures
node_muts <- tree_df %>% dplyr::select(node, branch.length)
exposures$node = as.numeric(str_extract(exposures$branch_id, '(?<=\\_)\\d+'))
exposures$SBSAssigned=exposures$SBS1+exposures$SBS5+exposures$SBS18+exposures$SBS88+exposures$SBS89
exposures = left_join(exposures, node_muts, by='node')
exposures$SBSUnassigned=ifelse(exposures$branch.length - exposures$SBSAssigned>0, exposures$branch.length - exposures$SBSAssigned, 0)
exposures <- exposures %>%
dplyr::select(-SBSAssigned)%>%
mutate(across(contains('SBS'),~(.x / rowSums(exposures[, grepl("SBS", colnames(exposures)), drop = FALSE]))*branch.length))%>%
dplyr::select(-node, -branch.length)
row.names(exposures) = exposures$branch_id
trunk_branches=paste0(patient,'_',tree_df[tree_df$x<50 & tree_df$branch.length<50,]$node)
insufficient_length_branches=paste0(patient,'_',tree_df[tree_df$x>50&tree_df$branch.length<44,]$node)
## trunk adjustments
exposures$SBSTrunk = ifelse(
exposures$branch_id %in% trunk_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
exposures$SBSInsufficient= ifelse(
exposures$branch_id %in% insufficient_length_branches,
exposures$SBS1 + exposures$SBS5 + exposures$SBS18 +
exposures$SBS88 + exposures$SBS89 +
exposures$SBSUnassigned,
0
)
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned","SBSInsufficient")){
exposures[[s]] <- ifelse(exposures$SBSTrunk > 0, 0, exposures[[s]])
}
for (s in c("SBS1","SBS5","SBS18","SBS88","SBS89","SBSUnassigned")){
exposures[[s]] <- ifelse(exposures$SBSInsufficient > 0, 0, exposures[[s]])
}
exposures<-exposures%>%
mutate(SBSBackground=SBS1+SBS5+SBS18+SBSUnassigned)%>%
dplyr::select(branch_id,SBSBackground,SBSTrunk,SBSInsufficient,SBS89,SBS88)
row.names(exposures)<-exposures$branch_id
sigs = colnames(exposures)[2:length(colnames(exposures))]
cols = c("bisque2",'grey20','grey40','palegreen4',"maroon3")
names(cols) = sigs
samples = exposures$branch_id[grepl(patient, exposures$branch_id)]
branches = sub(".*_", "", samples)
