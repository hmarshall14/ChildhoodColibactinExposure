plot_layout(widths = c(3, 1))
plot(fig2$relab_contaminant, fig2$relab_gut, pch = 19, cex = .5, col = "grey30",
xlim = c(0, 1), xlab = "contaminant relative abundance",
ylab = "gut relative abundance", main = "Fig 2: per-sample composition")
abline(a = 1, b = -1, lty = 3)
prop_nonbiological_enriched=round(nrow(fig2[fig2$relab_nonbiological>0.5,])/nrow(fig2),2)*100
contaminant_gut_relab_plt<-ggplot(data=fig2,aes(x=relab_gut,y=relab_nonbiological ,col='grey30'))+
geom_point(col='grey30')+
