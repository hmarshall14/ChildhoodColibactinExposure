dev.off()
#summary statistics
print(median(fig2$relab_nonbiological))
print(paste0('IQR: [',round(quantile(fig2$relab_nonbiological,0.25),2),', ',round(quantile(fig2$relab_nonbiological,0.75),2),']'))
#summary statistics for impossible taxa :
print(round(median(fig2$relab_impossible_clade),2))
print(paste0('IQR: [',round(quantile(fig2$relab_impossible_clade,0.25),2),', ',round(quantile(fig2$relab_impossible_clade,0.75),2),']'))
print(paste0('Proportion of samples :',nrow(fig2[fig2$relab_impossible_clade>0,])/nrow(fig2)))
ggplot(data=fig3,aes(x=gut_reads, y=max_gut_coverage_X))+
scale_x_log10()+
scale_y_log10()+
labs(x='Gut taxa reads per sample',y='Coverage of best gut taxon per sample [X]')+
geom_hline(yintercept=0.05,col='firebrick',linetype=5)+
geom_vline(xintercept=T_QUANT_15X,col='steelblue',linetype=5)+
geom_vline(xintercept=T_QUANT_2X,col='steelblue',linetype=5)+
geom_text(label='Coverage 0.05X' ,x=log10(100000),hjust=-0.02,vjust=-0.5,y=log10(0.05),
col='black',size=3)+
geom_text(label='' ,x=0.5,hjust=-0.02,vjust=-0.5,y=0.5,
col='black',size=6,col='grey30')+
geom_text(label='' ,x=0.5,hjust=-0.02,vjust=-0.5,y=0.5,
col='grey30',size=6,col='grey30')+
geom_point()+
theme(axis.title = element_text(size=20,face='bold'),
axis.text = element_text(size=16,face='bold'),
legend.position='none',
legend.title = element_text(size=20,face='bold'),
legend.text = element_text(size=16,face='bold')
)
# print summary statistics:
print(paste0('Number of samples meeting threshold 1: ',nrow(fig3[fig3$max_gut_coverage_X>0.05,])))
print(paste0('Median taxa for  samples meeting threshold 1: ',median(fig3[fig3$max_gut_coverage_X>0.05,]$n_gut_breadth_verifiable)))
print(paste0('Median taxa for  samples meeting threshold 1: ',quantile(fig3[fig3$max_gut_coverage_X>0.05,]$n_gut_breadth_verifiable,0.25)))
print(paste0('Median taxa for  samples meeting threshold 1: ',quantile(fig3[fig3$max_gut_coverage_X>0.05,]$n_gut_breadth_verifiable,0.75)))
cov_of <- function(reads) reads * bases_per_read / DEFAULT_GENOME
coverage_plt<-ggplot(data=fig3,aes(x=gut_reads+1,y=max_gut_coverage_X+1e-9))+
scale_x_log10()+
scale_y_log10()+
labs(x='Total gut taxa reads per sample',
y='Coverage of best single gut taxon [X]')+
geom_hline(yintercept=cov_of(T_DETECT),col="grey50",linetype=5)+
geom_text(label='Bacteria detectable [min 10 reads]',x=Inf,vjust=-0.5,hjust=1.02,size=5,y=log10(cov_of(T_DETECT)),col="grey50",inherit.aes = FALSE)+
geom_hline(yintercept=cov_of(T_QUANT_2X),  col = "steelblue", linetype = 2)+
geom_text(label='Detect 2-fold change [min 33 reads]',x=Inf,vjust=-0.5,hjust=1.02,size=5,y=log10(cov_of(T_QUANT_2X)),col="steelblue")+
geom_hline(yintercept=T_BREADTH_X,  col = "firebrick", linetype = 2)+
geom_text(label='Genome breadth-verifiable coverage\n[min 667 reads]',x=Inf,vjust=0.5,hjust=1.02,y=log10(T_BREADTH_X),size=5,col="firebrick")+
geom_point(col='grey10')+
theme(axis.title = element_text(size=20,face='bold'),
axis.text = element_text(size=16,face='bold'),
legend.position='none',
legend.title = element_text(size=20,face='bold'),
legend.text = element_text(size=16,face='bold')
)
summary_taxa_dataected<-rbind(
detected      = table(factor(pmin(fig3$n_gut_detected, 5), levels = 0:5)),
quant_2fold   = table(factor(pmin(fig3$n_gut_quantifiable_2x, 5), levels = 0:5)),
usable_2fold  = table(factor(pmin(fig3$n_gut_usable_2x, 5), levels = 0:5))
)%>%
as.data.frame()%>%
rownames_to_column(var='threshold')%>%
pivot_longer(cols=!contains('threshold'))
detectable_plt<-ggplot(data=summary_taxa_dataected,aes(x=threshold,fill=name,y=value))+
geom_bar(stat='identity',col='black')+
labs(x='Fraction of samples',y='',fill='Number of\ngut taxa')+
scale_x_discrete(breaks=c("detected","quant_2fold", "usable_2fold"),
labels=c('Detected','Detect 2-fold\nchange','Genome Breadth verify')
)+
scale_fill_manual(breaks=c(5,4,3,2,1,0),
labels=c('5+','4','3','2','1','0'),
values=c('grey0','grey20','grey40','grey60','grey80','grey100'))+
theme(axis.title = element_text(size=20,face='bold'),
axis.text = element_text(size=16,face='bold'),
legend.position='bottom',
legend.title = element_text(size=20,face='bold'),
legend.text = element_text(size=16,face='bold')
)
coverage_combined<-coverage_plt|detectable_plt+
plot_layout(width=c(10,1))
coverage_combined
