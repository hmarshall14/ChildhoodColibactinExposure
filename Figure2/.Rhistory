compare_mutation_age_df <- mutational_age_df %>%
# keep only the columns needed to identify a crypt, so that the join with the
# background rates cannot introduce extra columns and break pivot_wider
dplyr::select(
patient, biopsy, sample, cohort, site, age,
biopsy_colibactin_pos, mut_type, mutational_age
) %>%
pivot_wider(names_from = mut_type, values_from = mutational_age)
# Fit one model per side x mutation class and return the colibactin effect with
# a Wald 95% confidence interval. Coefficients are extracted by name rather
# than by position.
fit_mutational_age_model <- function(side, response, data) {
model_formula <- reformulate(
c("biopsy_colibactin_pos", "(1 | cohort)", "(1 | patient)"),
response = response
)
model <- lmer(model_formula, data = filter(data, site == side))
tidy(model, effects = "fixed") %>%
filter(startsWith(term, "biopsy_colibactin_pos")) %>%
transmute(
site      = side,
mut_type  = response,
estimate  = round(estimate,0),
low_ci    = round(estimate - 1.96 * std.error,0),
upp_ci    = round(estimate + 1.96 * std.error,0),
p.value   = round(p.value,3)
)
}
mutational_age_results <- expand_grid(
side     = c("Left", "Right"),
response = c("SBS", "ID")
) %>%
pmap_dfr(function(side, response) {fit_mutational_age_model(side, response, compare_mutation_age_df) })
mutational_age_results
mutational_age_results %>%
mutate(
summary = sprintf(
"%s %s mutational age: %.0f [%.0f, %.0f] years, P = %s",
site, mut_type, estimate, low_ci, upp_ci, format.pval(p.value, digits = 3)
)
) %>%
pull(summary) %>%
walk(~ cat(.x, "\n"))
plot_mutational_age %>%
filter(str_detect(biopsy, "PD69095|PD68018")) %>%
mutate(mutational_age = round(abs(mutational_age),0)) %>%
dplyr::select(biopsy, site, age, mut_type, mutational_age) %>%
arrange(biopsy, mut_type)
sessionInfo()
knitr::opts_chunk$set(
echo       = TRUE,
message    = FALSE,
warning    = FALSE,
comment    = "#>",
fig.width  = 7,
fig.height = 4,
dpi        = 300
)
set.seed(42)
library(ggh4x)
library(dplyr)
library(tidyverse)
library(emmeans)
library(ggplot2)
library(lmerTest)
library(broom.mixed)
## paediatric samples
crypt_signature_attributions<-read.csv('../Data/crypt_signature_attributions.csv')
crypt_metadata<-read.csv('../Data/biopsy_metadata.csv')
## adult samples
lee_six_2019_nature<-read.csv('../Data/lee_six_nature_2019_sbs_id_attribution.csv')%>%
mutate(site=ifelse(site=='Transverse','Right',site))%>%
filter(site!='Ileum')
# construct a dataframe for regression models
colibactin_burdens_regressions_df<-left_join(crypt_metadata,crypt_signature_attributions,by=c('biopsy','patient'))%>%
ungroup()%>%
filter(location %in% c('Sigmoid','Ascending','Transverse'))%>% # exclude terminal ileum / caecum / rectum
filter(SBS88>0 & ID18>0)%>%
dplyr::select(patient,biopsy,site,sex,SBS88,ID18,age)
# adult crypt burdens
adult_colibactin_burdens_regression_df<-lee_six_2019_nature%>%
mutate(biopsy=paste(patient,site,sep='_'))%>%
dplyr::select(patient, biopsy,site,sex,SBS88, ID18, age)%>%
filter(SBS88>0 & ID18>0)
colibactin_burdens_regressions_df<-rbind(colibactin_burdens_regressions_df,adult_colibactin_burdens_regression_df)
# run mixed effects regression for SBS88 and ID18
models_df <- colibactin_burdens_regressions_df %>%
pivot_longer(c(SBS88, ID18), names_to = "mut_type", values_to = "burden") %>%
nest(data = -mut_type) %>%
mutate(
model = map(data, ~ lmer(burden ~ age * site + (1 | patient), data = .x)),
# slope within each site, with CI + p-value vs 0
slopes = map(model, ~ emtrends(.x, ~ site, var = "age") %>%
summary(infer = c(TRUE, TRUE)) %>%
as_tibble()),)
models_output<-models_df %>% select(mut_type, slopes)%>%
unnest(slopes)%>%
mutate(p.adj=p.adjust(p.value,'fdr'))
print(models_output)
## plot association of colibactin mutagenesis versus time
# construct a dataframe for plotting:
colibactin_burdens_plot_df<-colibactin_burdens_regressions_df%>%
pivot_longer(cols=c('SBS88','ID18'),names_to='mut_type',values_to='counts')%>%
mutate(site=ifelse(site=='Transverse','Right',site))%>%
filter(site!='Ileum')%>%
group_by(patient, site, mut_type)%>%
summarise(median=median(counts,na.rm=T),
lower=quantile(counts,0.25,na.rm=T),
upper=quantile(counts,0.75,na.rm=T),
age=median(age))%>%
mutate(mut_type=factor(mut_type,levels=c('SBS88','ID18')))
make_pred <- function(m, d, n = 100) {
rng  <- d %>% group_by(site) %>% summarise(lo = min(age), hi = max(age), .groups = "drop")
ages <- seq(min(d$age), max(d$age), length.out = n)
emmeans(m, ~ age | site, at = list(age = ages)) %>%
as_tibble() %>%
left_join(rng, by = "site") %>%
filter(age >= lo, age <= hi) %>%          # don't extrapolate past each site's data
transmute(site, age, fit = emmean, lwr = lower.CL, upr = upper.CL)
}
regression_df_expanded <- models_df %>%
transmute(mut_type, pred = map2(model, data, make_pred)) %>%
unnest(pred)%>%
mutate(mut_type=factor(mut_type,levels=c('SBS88','ID18')))
labels_df <- models_output %>%
transmute(
mut_type, site,
label = paste0(round(age.trend,1),'mutations/year [95%CI ',round(lower.CL,1),', ',round(upper.CL,1),']')
)%>%
mutate(mut_type=factor(mut_type,levels=c('SBS88','ID18')))
svglite::svglite('../Figure2/colibactin_age_burdens.svg',width=12,height=7)
ggplot(data = colibactin_burdens_plot_df, aes(x = age, y = median)) +
geom_ribbon(data = regression_df_expanded,
aes(x = age, ymin = lwr, ymax = upr),fill = 'grey60',
inherit.aes = FALSE, alpha = 0.5, show.legend = FALSE) +
geom_line(data = regression_df_expanded,
aes(x = age, y = fit,  linetype = "Mutation Burden ~ Age"),
inherit.aes = FALSE, linewidth = 0.8,colour = 'grey20') +
geom_errorbar(aes(ymin = lower, ymax = upper),size = 1, width = 0, colour = "grey60",alpha=1) +
geom_point(fill = 'maroon3', shape=21,col='grey10',size = 2) +
scale_x_continuous() +
facet_grid(mut_type~site, scales = "free",
switch='y',
label = labeller(mut_type = as_labeller(c(SBS88 = "SBS 88 Burden", ID18 = "ID 18 Burden")),
site = as_labeller(c(Left = "Colon Left Side", Right = "Colon Right Side")))) +
facetted_pos_scales(y = list(mut_type == "SBS88" ~ scale_y_continuous(limits = c(0, 2250)),
TRUE ~ scale_y_continuous(limits = c(0, 400)))) +
theme_classic() +
scale_linetype_manual(
values = c("Mutation Burden ~ Age" = "dashed"),
name = NULL
) +
scale_alpha_manual(
values = c("Mutation Burden ~ Age" = 0.5),
name = NULL
) +
labs(
x = "Donor Age at Biopsy [years]",
y = "",
fill = "Biopsy Site"
) +
theme(
axis.title = element_text(size = 16, face = "bold"),
strip.background = element_blank(),
axis.text = element_text(size = 14, face = "bold", colour = "grey20"),
legend.title = element_text(size = 16, face = "bold"),
legend.text = element_text(size = 14),
legend.position = "bottom",
strip.placement.y='outside',
strip.placement.x='inside',
strip.text = element_text(size = 18, face = "bold")
)
dev.off()
knitr::opts_chunk$set(
echo       = TRUE,
message    = FALSE,
warning    = FALSE,
comment    = "#>",
fig.width  = 7,
fig.height = 4,
dpi        = 300
)
set.seed(42)
library(dplyr)
library(lmerTest)
library(tidyverse)
library(readxl)
library(stringr)
crypt_metadata<-read.csv('../Data/biopsy_metadata.csv')
crypt_signature_attributions <- read.csv('../Data/crypt_signature_attributions.csv')
dnds_mut_annotation<-read.delim('../Data/dnds_mut_annotation.tsv')
## combine crypt annotation of colibactin positive with dNdS outputs :
coding_mutations_df <- left_join(crypt_metadata,crypt_signature_attributions,by=c('biopsy','patient')) %>%
dplyr::select(patient,biopsy,sample, biopsy_colibactin_pos,crypt_colibactin_pos,age,location,site,cohort,
missense, nonsense, synonymous, indel,essential_Splice,stop_loss)
coding_mutations_long<-coding_mutations_df%>%
pivot_longer(cols=c('nonsense', 'missense','indel','synonymous'),names_to='Effect',values_to = 'muts')
fit_effect_model <- function(effect) {
summary(lmer(muts ~ crypt_colibactin_pos + age + (1 | patient) + (1 | location), data = coding_mutations_long[coding_mutations_long$Effect == effect,]))}
ml_results <- list(
indel      = fit_effect_model("indel"),
missense   = fit_effect_model("missense"),
nonsense   = fit_effect_model("nonsense"),
synonymous = fit_effect_model("synonymous")
)
## extract p values from regression :
extract_colibactin_p <- function(model_summary) {
coef_tab <- model_summary$coefficients
p <- coef_tab["crypt_colibactin_posTRUE", "Pr(>|t|)"]
}
coding_p_df <- tibble(
Effect = names(ml_results),
pvalue = purrr::map_dbl(ml_results, extract_colibactin_p))%>%
mutate(Effect = factor(Effect, levels = c("missense", "nonsense", "indel", "synonymous")))
## adjust pvalues using Benhamini Hochberg :
coding_p_df$pvalue_adj=p.adjust(coding_p_df$pvalue,method='BH')
coding_p_df$label=case_when(coding_p_df$pvalue_adj<0.001 ~'P < 0.001',
TRUE~paste0('P = ',round(coding_p_df$pvalue_adj,digits=3)))
## extract y coords for plots:
y_coords<-coding_mutations_long %>%
group_by(Effect) %>%
summarise(y = max(muts, na.rm = TRUE) * 1.10)
coding_p_df <- coding_p_df %>%
left_join(y_coords, by = "Effect")
print(coding_p_df)
svg('../Figure2/compare_coding_muts.svg',width=6, height=10)
# intiialise plot
ggplot(coding_mutations_long, aes(x = crypt_colibactin_pos, y = muts)) +
# create boxplot :
geom_boxplot(aes(fill = crypt_colibactin_pos)) +
# facet by effect
facet_wrap(~Effect, scales = "free", ncol = 2,
labeller=labeller(Effect=c(nonsense='Nonsense',
missense='Missense',
indel='Indels',
synonymous='Synonymous'))) +
# add text for pvalues and associated brackets
geom_text(data = coding_p_df, aes(label = label, y = y, x = 1.5),fontface = "bold")+
geom_segment(data = coding_p_df, aes(x = 1, xend = 2, y = 0.96*y, yend = 0.96*y),color='grey20', inherit.aes = FALSE, size = 0.6) +
geom_segment(data = coding_p_df, aes(x = 1, xend = 1, y = 0.96*y, yend = 0.945*y),  color='grey20',inherit.aes = FALSE, size = 0.6) +
geom_segment(data = coding_p_df, aes(x = 2, xend = 2, y = 0.96*y, yend = 0.945*y),  color='grey20',inherit.aes = FALSE, size = 0.6) +
# format x and fill scales
scale_x_discrete(breaks = c(TRUE, FALSE), labels = c("Colibactin\nPositive", "Colibactin\nNegative")) +
scale_fill_manual(values = c('bisque3','hotpink3')) +
# add labels
labs(y = "Coding Sequence Mutations per Crypt", x = "Colibactin Mutagenesis Status") +
# format theme
theme_classic() +
theme(
axis.text.x = element_text(size = 14, face='bold',colour = "black"),
axis.text.y = element_text(size = 14,colour = "black"),
axis.title.y = element_text(size = 18, face = "bold"),
axis.title.x = element_blank(),
strip.text = element_text(size = 16, face = "bold"),
strip.placement = "inside",
strip.background = element_blank(),
legend.position = "none"
)
dev.off()
svg('../Figure2/compare_coding_muts.svg',width=6, height=10)
# intiialise plot
ggplot(coding_mutations_long, aes(x = crypt_colibactin_pos, y = muts)) +
# create boxplot :
geom_boxplot(aes(fill = crypt_colibactin_pos)) +
# facet by effect
facet_wrap(~Effect, scales = "free", ncol = 2,
labeller=labeller(Effect=c(nonsense='Nonsense',
missense='Missense',
indel='Coding Indels',
synonymous='Synonymous'))) +
# add text for pvalues and associated brackets
