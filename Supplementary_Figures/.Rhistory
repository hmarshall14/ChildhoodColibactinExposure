aes(x = age_earliest_commencement, xend = value,  yend = ypos), col = 'maroon3', alpha=1,size=1.7) +
## plot bar for continuation beyond point :
geom_segment(data=crypt_bar_plot[crypt_bar_plot$timepoint=='age_continuation',],
aes(x = value, xend = donor_age,  yend = ypos), col = 'maroon3', alpha=0.3,size=1.7) +
# plot bar beyond cessation timepoint
geom_segment(data=crypt_bar_plot[crypt_bar_plot$timepoint=='age_cessation',],
aes(x = value, xend = donor_age, yend = ypos),
col = 'bisque3',  alpha=1,size=1.7) +
scale_alpha_manual(
values = c(
"First positive branch" = 1,
"Subsequent positive branch" = 0.3
)
) +
## add points for commmencement / cessation :
geom_point(data=crypt_bar_plot[crypt_bar_plot$timepoint%in%c('age_earliest_commencement','age_cessation','age_continuation','age_indeterminant_timepoint','secondary_bifurcation'),],
aes(x = value,
y = ypos,
colour='black',fill = timepoint),
size = 3.5, colour='black', shape=23,alpha=0.9,stroke=0.75, na.rm = TRUE) +
#facet_grid(pdid_f ~ ., scales = "free_y", space = "free_y")+
scale_fill_manual(breaks = c(
"age_continuation",
"age_cessation",
"age_earliest_commencement",
"age_indeterminant_timepoint",
"secondary_bifurcation"
),
values = c(
"age_continuation" = "springgreen2",
"age_cessation" = "orange1",
"age_earliest_commencement"='skyblue2',
"age_indeterminant_timepoint"='grey75',
'secondary_bifurcation'='grey10'
),
labels = c(
"age_continuation" = "Known Timepoint of Ongoing Exposure",
"age_cessation" = "Latest Possible Cessation",
"age_earliest_commencement"="Earliest Possible Commencement",
"age_indeterminant_timepoint" = 'Indeterminant Timepoint',
"secondary_bifurcation" = 'Subsequent crypt bifurcation')
) +
labs(y='Colonic Crypts Grouped by Donor', x='Window for exposure [years]')+
facet_grid(patient_f~.,scales='free',switch='y',space='free_y')+
scale_x_continuous(breaks = seq(0, 20, 5),minor_breaks = seq(0, 20, 1), expand = expansion(mult = c(0.01, 0.02)))+
coord_cartesian(clip = "off") +
theme(axis.text.y=element_blank(),
axis.title=element_text(size=16,font='bold'),
axis.text.x=element_text(size=14),
axis.ticks.y = element_blank(),
strip.background = element_blank(),
strip.placement='inside',
strip.text = element_blank(),
legend.position='none',
legend.title = element_blank()
)
swimmers_plt
png('../Figure4/crypt_by_crypt_swimmers_plot.png',width=2800,height=3600,res=300, bg='transparent')
swimmers_plt
dev.off()
## create dataframe for plotting
legend_df<-data.frame(
colour=c('skyblue2',"springgreen2",'orange1','grey75','maroon3',scales::alpha("maroon3", 0.5),'bisque3'),
timepoint=c('Earliest Possible Commencement of Exposure',
'Timepoint of Ongoing Exposure',
'Latest Possible Cessation of Exposure',
'Indeterminant Timepoint [Insufficient branch length / SBS88 present in unpruned attribution]',
'First positive branch',
'Subsequent positive branch',
'Colibactin negative branch'),
shape=c(23,23,23,23,22,22,22)
)
## create plot
